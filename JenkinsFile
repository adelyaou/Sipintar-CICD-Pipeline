pipeline {
    agent any

    environment {
        REGISTRY = "docker.io/adelyao"
        IMAGE_NAME = "sipintar-app"
    }

    stages {
        stage('Build Docker Image') {
            when { branch 'adel' }
            steps {
                script {
                    appImage = docker.build("${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}")
                }
            }
        }

        stage('Run Tests') {
            when { branch 'adel' }
            steps {
                script {
                    appImage.inside {
                        sh 'npm test'
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            when { branch 'adel' }
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        appImage.push()
                    }
                }
            }
        }

        stage('Deploy to Staging') {
            when { branch 'adel' }
            steps {
                script {
                    sh '''
                        docker rm -f app || true
                        docker run -d --name app -p 3000:3000 ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }   
        failure {
            echo 'Pipeline failed!'
        }
        success {
            echo 'Pipeline succeeded!'
        }
    }
}
