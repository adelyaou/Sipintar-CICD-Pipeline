pipeline {
    agent any

    environment {
        REGISTRY = "docker.io/adelyao"
        IMAGE_NAME = "sipintar-app"
        DOCKER_CREDS = credentials('dockerhub-credentials')
    }

    stages {
        stage('Build Docker Image') {
            when { branch 'adel' }
            steps {
                sh 'docker build -t $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER} .'
            }
        }

        stage('Run Tests') {
            when { branch 'adel' }
            steps {
                sh 'docker run --rm $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER} npm test'
            }
        }

        stage('Push to Docker Hub') {
            when { branch 'adel' }
            steps {
                withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                    sh 'docker push $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER}'
                }
            }
        }

        stage('Deploy to Staging') {
            when { branch 'adel' }
            steps {
                sh '''
                    docker rm -f app || true
                    docker run -d --name app -p 3000:3000 $REGISTRY/$IMAGE_NAME:${BUILD_NUMBER}
                '''
            }
        }
    }

     post {
        always {
            // Clean up workspace after pipeline execution
            cleanWs()
        }
        failure {
            echo 'Pipeline failed!'
            // Add notifications or other actions on failure
        }
        success {
            echo 'Pipeline succeeded!'
            // Add notifications or other actions on success
        }
    }
}
