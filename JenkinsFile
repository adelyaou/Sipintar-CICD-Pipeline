pipeline {
    agent any

    environment {
        REGISTRY   = "docker.io/adelyao"
        IMAGE_NAME = "sipintar-app"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            when { branch 'stag' }
            steps {
                script {
                    // build image pakai Docker Pipeline DSL
                    def builtImage = docker.build("${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}")

                    // simpan nama image ke environment variable supaya bisa dipakai di stage lain
                    env.IMAGE_TAG = "${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"

                    // tambahkan deskripsi build di Jenkins UI
                    currentBuild.description = env.IMAGE_TAG
                }
            }
        }
        stage('Run Tests') {
            when { branch 'stag' }
            steps {
                script {
                    docker.image(env.IMAGE_TAG).inside {
                        sh 'pnpm install --frozen-lockfile'
                        sh 'pnpm test'
                    }
                }
            }
        }
        stage('Push to Docker Hub') {
            when { branch 'stag' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    script {
                        sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        for i in 1 2 3; do
                            docker push $IMAGE_TAG && break
                            echo "Push failed, retrying in 10s..."
                            sleep 10
                        done
                        '''
                        }
                }
            }
        }
        stage('Deploy to Staging') {
            when { branch 'stag' }
            steps {
                 echo "Deploying ${IMAGE_NAME} to Development environment (docker swarm) ..."
                 dir ("${WORKSPACE}") {
                    sh '''
                    docker stack deploy -c docker-compose-prod.yml sipintar_stack_stag
                    docker stack services sipintar_stack_stag
                    '''
                 }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed!'
        }
        success {
            echo 'Pipeline succeeded!'
        }
    }
}
