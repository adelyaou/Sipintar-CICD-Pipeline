pipeline {
    agent any

    environment {
        REGISTRY   = "docker.io/adelyao"
        IMAGE_NAME = "sipintar-app"
    }

    stages {
        stage('Build Docker Image') {
            when { branch 'adel' }
            steps {
                script {
                    // build image pakai Docker Pipeline DSL
                    def builtImage = docker.build("${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}")

                    // simpan nama image ke environment variable supaya bisa dipakai di stage lain
                    env.IMAGE_TAG = "${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"

                    // tambahkan deskripsi build di Jenkins UI
                    currentBuild.description = env.IMAGE_TAG
                }
            }
        }
        stage('Run Tests') {
            when { branch 'adel' }
            steps {
                script {
                    docker.image(env.IMAGE_TAG).inside {
                        sh 'pnpm install --frozen-lockfile'
                        sh 'pnpm test'
                    }
                }
            }
        }
        stage('Push to Docker Hub') {
            when { branch 'adel' }
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        docker.image(env.IMAGE_TAG).push()
                    }
                }
            }
        }
        // stage('Deploy to Staging') {
        //     when { branch 'adel' }
        //     steps {
        //         sh '''
        //             docker rm -f app || true
        //             docker run -d --name app -p 3000:3000 $IMAGE_TAG
        //         '''
        //     }
        // }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            echo 'Pipeline failed!'
        }
        success {
            echo 'Pipeline succeeded!'
        }
    }
}
